<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ytunblock</vendor>

  <action id="org.ytunblock.helper">
    <description>Manage YouTube Unblock service</description>
    <description xml:lang="ru">Управление службой «YouTube без блокировок»</description>
    <message>Authentication is required to manage YouTube Unblock</message>
    <message xml:lang="ru">Для управления «YouTube без блокировок» нужна аутентификация</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/ytunblock/bin/ytu-helper</annotate>
  </action>

  <!-- a separate exec.path (not exec.argv1) so it works on every polkit version, 0.105 included -->
  <action id="org.ytunblock.uninstall">
    <description>Remove YouTube Unblock from the system</description>
    <description xml:lang="ru">Удалить «YouTube без блокировок» из системы</description>
    <message>Authentication is required to remove YouTube Unblock</message>
    <message xml:lang="ru">Для удаления «YouTube без блокировок» нужен пароль администратора</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/ytunblock/uninstall.sh</annotate>
  </action>
</policyconfig>
