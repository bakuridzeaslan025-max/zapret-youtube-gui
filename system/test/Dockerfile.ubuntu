FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends systemd systemd-sysv kmod iproute2 ca-certificates polkitd pkexec && rm -rf /var/lib/apt/lists/*
# privileged systemd containers otherwise unregister the Docker VM's binfmt (qemu) handlers on stop
RUN ln -sf /dev/null /etc/systemd/system/systemd-binfmt.service
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
